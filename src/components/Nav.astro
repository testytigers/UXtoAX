---
const p = Astro.url.pathname;
const active = (href: string) => p === href || (href !== '/' && p.startsWith(href));
---

<header class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo"><img src="/logo-uxintoax.svg" alt="uxintoax" class="nav-logo-img" /></a>

    <nav class="desktop-links">
      {[
        {href:'/', label:'Articles'},
      ].map(link => (
        <a href={link.href} class={active(link.href) ? 'active' : ''}>{link.label}</a>
      ))}
    </nav>

    <div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">
      <a href="#subscribe" class="desktop-links nav-cta">Subscribe</a>
      <button id="mmb" class="mobile-only" aria-label="Menu">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor">
          <rect y="2" width="18" height="2" rx="1"/>
          <rect y="8" width="18" height="2" rx="1"/>
          <rect y="14" width="18" height="2" rx="1"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="mmenu">
    {[{href:'/',label:'Articles'}].map(l=>(
      <a href={l.href}>{l.label}</a>
    ))}
    <a href="#subscribe" class="nav-cta mmenu-cta">Subscribe</a>
  </div>
</header>

<style>
  .site-nav {
    background: #000;
    position: sticky; top: 0; z-index: 50;
    border-bottom: 1px solid #1C1C1C;
  }
  .nav-inner {
    max-width: 1200px; margin: 0 auto; padding: 0 24px;
    height: 56px; display: flex; align-items: center;
    justify-content: space-between; gap: 24px;
  }
  .nav-logo {
    text-decoration: none; line-height: 1; flex-shrink: 0;
    display: flex; align-items: center;
  }
  .nav-logo-img { height: 26px; width: auto; display: block; }

  nav.desktop-links {
    display: flex; align-items: center; gap: 2px; flex: 1;
  }
  nav.desktop-links a {
    font-family: 'Open Sans', sans-serif;
    font-size: 0.875rem; font-weight: 500;
    color: rgba(255,255,255,0.6);
    text-decoration: none; padding: 5px 12px;
    border-radius: 4px; transition: color 0.12s;
  }
  nav.desktop-links a:hover { color: #fff; text-decoration: none; }
  nav.desktop-links a.active { color: #7CFF00; text-decoration: none; }

  .nav-cta {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem; font-weight: 700;
    background: #7CFF00; color: #000;
    padding: 7px 18px; border-radius: 5px;
    text-decoration: none; transition: background 0.15s;
    border: 1.5px solid #5BCC00;
  }
  .nav-cta:hover { background: #6AEC00; text-decoration: none; }

  #mmenu {
    display: none; background: #0A0A0A;
    border-top: 1px solid #1C1C1C;
    padding: 12px 24px 16px;
  }
  #mmenu a {
    display: block; font-family: 'Open Sans', sans-serif;
    font-size: 0.875rem; color: rgba(255,255,255,0.65);
    padding: 9px 0; border-bottom: 1px solid #1C1C1C;
    text-decoration: none;
  }
  #mmenu a:hover { color: #fff; text-decoration: none; }
  .mmenu-cta {
    display: block !important; text-align: center;
    margin-top: 12px; border-bottom: none !important;
  }

  .mobile-only {
    display: none; padding: 6px; background: transparent;
    border: none; cursor: pointer; color: rgba(255,255,255,0.65);
  }

  @media (max-width: 768px) {
    nav.desktop-links { display: none !important; }
    a.desktop-links { display: none !important; }
    .mobile-only { display: block !important; }
  }
</style>

<script>
  document.getElementById('mmb')?.addEventListener('click', () => {
    const m = document.getElementById('mmenu');
    if (m) m.style.display = m.style.display === 'none' ? 'block' : 'none';
  });
</script>
