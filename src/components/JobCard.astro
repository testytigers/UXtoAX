---
export interface Props {
  id: string; title: string; company: string; location: string;
  workType: string; experienceLevel: string; roleType: string;
  salary?: string; skills: string[]; description: string;
  applyUrl: string; postedAt: string; featured?: boolean;
}
const { title, company, location, workType, experienceLevel, roleType, skills, description, applyUrl, postedAt, salary } = Astro.props;

const wb: Record<string,string> = { remote:'pill-green', hybrid:'pill-amber', 'on-site':'pill-neutral' };
const days = Math.floor((Date.now() - new Date(postedAt).getTime()) / 86400000);
const posted = days === 0 ? 'Today' : days === 1 ? 'Yesterday' : `${days}d ago`;
---

<article class="card" style="padding:22px; display:flex; flex-direction:column; gap:14px; background:#FFFFFF;">
  <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:10px;">
    <div style="display:flex; align-items:center; gap:12px; min-width:0;">
      <div style="width:40px; height:40px; background:#EEF1FB; border:1px solid #C5CFEE; border-radius:9px; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-family:'JetBrains Mono',monospace; font-size:0.7rem; font-weight:700; color:#1C3FBD;">
        {company.slice(0,2).toUpperCase()}
      </div>
      <div style="min-width:0;">
        <p style="font-family:'JetBrains Mono',monospace; font-size:0.875rem; font-weight:700; color:#1A1A1A; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{title}</p>
        <p style="font-size:0.8rem; color:#6B6870; margin-top:2px;">{company} · {location}</p>
      </div>
    </div>
    <span class={`pill ${wb[workType]||'pill-neutral'}`} style="font-size:0.65rem; padding:2px 9px; text-transform:capitalize; flex-shrink:0;">{workType}</span>
  </div>
  <div style="display:flex; flex-wrap:wrap; gap:5px;">
    <span class="pill pill-accent" style="font-size:0.65rem; padding:1px 8px; text-transform:capitalize;">{roleType.replace(/-/g,' ')}</span>
    <span class="pill pill-neutral" style="font-size:0.65rem; padding:1px 8px; text-transform:capitalize;">{experienceLevel}</span>
    {salary && <span class="pill pill-neutral" style="font-size:0.65rem; padding:1px 8px;">{salary}</span>}
  </div>
  <p style="font-size:0.835rem; color:#6B6870; line-height:1.65; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">{description}</p>
  <div style="display:flex; flex-wrap:wrap; gap:5px;">
    {skills.slice(0,4).map(s => <span class="pill pill-neutral" style="font-size:0.65rem; padding:1px 8px;">{s}</span>)}
  </div>
  <div style="display:flex; align-items:center; justify-content:space-between; padding-top:12px; border-top:1px solid #E8E4DC;">
    <span style="font-family:'JetBrains Mono',monospace; font-size:0.73rem; color:#9A969E;">{posted}</span>
    <a href={applyUrl} target="_blank" rel="noopener" class="btn btn-primary" style="font-size:0.73rem; padding:5px 14px; border-radius:6px;">Apply →</a>
  </div>
</article>
