---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'job' | 'dataset';
  publishedAt?: string;
  updatedAt?: string;
  author?: string;
  category?: string;
  tags?: string[];
  readTime?: number;
  ogImage?: string;
  ogImageAlt?: string;
  schema?: object;
  faqs?: Array<{ q: string; a: string }>;
}

const {
  title,
  description,
  canonical = Astro.url.href,
  noindex = false,
  type = 'website',
  publishedAt,
  updatedAt,
  author = 'uxintoax',
  category,
  tags,
  ogImage = 'https://uxintoax.com/og/default.svg',
  ogImageAlt = 'uxintoax.com — From UX to AX',
  schema: customSchema,
  faqs,
} = Astro.props;

const siteTitle = `${title} — uxintoax.com`;
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';

let canonicalPath = '/';
try { canonicalPath = new URL(canonical).pathname; } catch { /* fallback */ }
const isHomepage = canonicalPath === '/';

// ── Always-present: WebSite + Organization ────────────────────────────────
const websiteOrgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://uxintoax.com/#website',
      url: 'https://uxintoax.com',
      name: 'uxintoax.com',
      description: 'From UX to AX — the discipline of designing for agents.',
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: 'https://uxintoax.com/blog?q={search_term_string}',
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': 'https://uxintoax.com/#organization',
      name: 'uxintoax.com',
      url: 'https://uxintoax.com',
      logo: { '@type': 'ImageObject', url: 'https://uxintoax.com/logo.png' },
      sameAs: [
        'https://twitter.com/uxintoax',
        'https://linkedin.com/company/uxintoax',
      ],
    },
  ],
};

// ── Article ───────────────────────────────────────────────────────────────
const articleSchema = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: title,
  description,
  url: canonical,
  ...(publishedAt ? { datePublished: publishedAt } : {}),
  ...(publishedAt ? { dateModified: updatedAt || publishedAt } : {}),
  author: { '@type': 'Person', name: author, url: 'https://uxintoax.com/about' },
  publisher: {
    '@type': 'Organization',
    name: 'uxintoax.com',
    '@id': 'https://uxintoax.com/#organization',
  },
  image: ogImage,
  ...(tags && tags.length > 0 ? { keywords: tags.join(', ') } : {}),
  ...(category ? { articleSection: category } : {}),
  inLanguage: 'en-US',
  isPartOf: { '@id': 'https://uxintoax.com/#website' },
} : null;

// ── FAQPage ───────────────────────────────────────────────────────────────
const faqSchema = faqs && faqs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
} : null;

// ── JobPosting ────────────────────────────────────────────────────────────
const jobSchema = type === 'job' ? {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title,
  description,
  ...(publishedAt ? { datePosted: publishedAt } : {}),
  hiringOrganization: { '@type': 'Organization', name: author },
  ...(category ? { jobLocation: { '@type': 'Place', address: category } } : {}),
} : null;

// ── Dataset ───────────────────────────────────────────────────────────────
const datasetSchema = type === 'dataset' ? {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Top UX Design Skills in Demand',
  description: 'Weekly, monthly, quarterly, and yearly data on the most in-demand UX and AX design skills, derived from job listing analysis.',
  url: 'https://uxintoax.com/skills',
  creator: { '@type': 'Organization', name: 'uxintoax.com' },
  temporalCoverage: '2025/..',
  keywords: ['UX skills', 'AX design', 'design jobs', 'skills demand', 'UX trends'],
} : null;

// ── BreadcrumbList (inner pages only) ─────────────────────────────────────
const sectionNames: Record<string, string> = {
  blog: 'Blog', jobs: 'Jobs', skills: 'Skills', 'what-is-ax': 'What is AX?',
};
const breadcrumbSchema = (() => {
  if (isHomepage) return null;
  const parts = canonicalPath.split('/').filter(Boolean);
  const items: object[] = [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://uxintoax.com' },
  ];
  if (parts.length >= 1) {
    items.push({
      '@type': 'ListItem',
      position: 2,
      name: sectionNames[parts[0]] ?? parts[0],
      item: `https://uxintoax.com/${parts[0]}`,
    });
  }
  if (parts.length >= 2) {
    items.push({ '@type': 'ListItem', position: 3, name: title, item: canonical });
  }
  return { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: items };
})();

const allSchemas = [
  websiteOrgSchema,
  articleSchema,
  faqSchema,
  jobSchema,
  datasetSchema,
  breadcrumbSchema,
  customSchema ?? null,
].filter((s): s is object => s !== null);
---

<title>{siteTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robotsContent} />
<meta name="author" content={author} />
{tags && tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="uxintoax.com" />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:secure_url" content={ogImage} />

{type === 'article' ? (
  <Fragment>
    <meta property="og:type" content="article" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {publishedAt && <meta property="article:modified_time" content={updatedAt || publishedAt} />}
    <meta property="article:author" content={author} />
    {category && <meta property="article:section" content={category} />}
    {tags && tags.map(tag => <meta property="article:tag" content={tag} />)}
  </Fragment>
) : (
  <meta property="og:type" content="website" />
)}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@uxintoax" />
<meta name="twitter:creator" content="@uxintoax" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

<!-- Discovery + PWA -->
<meta name="pinterest-rich-pin" content="true" />
<link rel="alternate" type="application/rss+xml" title="uxintoax.com Blog" href="/rss.xml" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- JSON-LD -->
{allSchemas.map(s => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
