---
---

<section class="sub-block">
  <h2 class="sub-heading">Subscribe</h2>
  <p class="sub-sub">AX insights, top jobs, and in-demand skills — every week. No noise.</p>
  <form class="sub-form" id="sf-form" novalidate>
    <input
      class="sub-input"
      type="email" name="email"
      placeholder="your@email.com" required
    />
    <button class="sub-btn" type="submit">Subscribe →</button>
  </form>
  <p class="sub-msg" id="sf-msg"></p>
</section>

<style>
  .sub-block {
    background: #111; border: 1px solid #2A2A2A;
    border-radius: 8px; padding: 40px 36px;
    text-align: center;
  }
  .sub-heading {
    font-family: 'Bebas Neue', 'JetBrains Mono', sans-serif;
    font-size: 2.5rem; color: #fff; line-height: 1;
    text-transform: uppercase; letter-spacing: 0.02em;
    margin-bottom: 8px;
  }
  .sub-sub {
    font-size: 0.9rem; color: #555; line-height: 1.6;
    max-width: 340px; margin: 0 auto 24px;
    font-family: 'Open Sans', sans-serif;
  }
  .sub-form {
    display: flex; gap: 0; max-width: 420px; margin: 0 auto;
    border: 1px solid #2A2A2A; border-radius: 6px; overflow: hidden;
  }
  .sub-input {
    flex: 1; background: #0A0A0A; border: none; outline: none;
    padding: 11px 16px; font-size: 0.9rem; min-width: 0;
    color: #E0E0E0; font-family: 'Open Sans', sans-serif;
    transition: background 0.15s;
  }
  .sub-input::placeholder { color: #3A3A3A; }
  .sub-input:focus { background: #141414; }
  .sub-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem; font-weight: 700;
    background: #7CFF00; color: #000; border: none;
    padding: 11px 22px; cursor: pointer;
    transition: background 0.15s; white-space: nowrap; flex-shrink: 0;
  }
  .sub-btn:hover { background: #6AEC00; }
  .sub-msg {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem; color: #7CFF00;
    margin-top: 10px; display: none;
  }
</style>

<script>
  const form = document.getElementById('sf-form') as HTMLFormElement | null;
  const msg  = document.getElementById('sf-msg');
  form?.addEventListener('submit', e => {
    e.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement)?.value?.trim();
    if (!email || !msg) return;
    msg.textContent = "✓ You're in. First digest coming soon.";
    msg.style.display = 'block';
    form.reset();
  });
</script>
