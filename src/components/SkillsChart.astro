---
export interface Props {
  chartId?: string;
  showPeriodToggle?: boolean;
}
const { chartId = 'skills-chart', showPeriodToggle = false } = Astro.props;
---

<div class="chart-root" data-chart-id={chartId} data-toggle={showPeriodToggle ? 'true' : 'false'}>
  {showPeriodToggle && (
    <div class="period-toggle" style="display:flex; gap:6px; margin-bottom:20px; flex-wrap:wrap;">
      {['weekly','monthly','quarterly','yearly'].map(p => (
        <button
          class="period-btn"
          data-period={p}
          style={`font-family:'JetBrains Mono',monospace; font-size:0.75rem; font-weight:600; padding:5px 14px; border-radius:6px; cursor:pointer; border:1px solid ${p === 'weekly' ? '#1532A8' : '#E8E4DC'}; background:${p === 'weekly' ? '#1C3FBD' : '#EDEAE3'}; color:${p === 'weekly' ? '#fff' : '#6B6870'}; transition:all 0.15s;`}
        >{p.charAt(0).toUpperCase() + p.slice(1)}</button>
      ))}
    </div>
  )}
  <div class="chart-container" style="width:100%; min-height:240px;"></div>
  <p class="chart-loading" style="font-family:'JetBrains Mono',monospace; font-size:0.8rem; color:#9A969E; padding:20px 0;">Loading chart…</p>
</div>

<script>
const SKILLS = {
  weekly:    [{s:'Figma',p:78},{s:'User Research',p:66},{s:'AI Tools',p:46},{s:'Prototyping',p:45},{s:'Design Systems',p:43},{s:'Wireframing',p:38},{s:'Usability Testing',p:32},{s:'Interaction Design',p:31},{s:'Information Architecture',p:28},{s:'AX Design',p:22}],
  monthly:   [{s:'Figma',p:81},{s:'User Research',p:71},{s:'Prototyping',p:50},{s:'AI Tools',p:47},{s:'Design Systems',p:45},{s:'Wireframing',p:39},{s:'Usability Testing',p:36},{s:'Interaction Design',p:33},{s:'Information Architecture',p:29},{s:'AX Design',p:24}],
  quarterly: [{s:'Figma',p:83},{s:'User Research',p:71},{s:'Prototyping',p:49},{s:'Design Systems',p:45},{s:'AI Tools',p:43},{s:'Wireframing',p:39},{s:'Usability Testing',p:35},{s:'Interaction Design',p:33},{s:'Information Architecture',p:28},{s:'AX Design',p:22}],
  yearly:    [{s:'Figma',p:85},{s:'User Research',p:72},{s:'Prototyping',p:50},{s:'Design Systems',p:46},{s:'AI Tools',p:43},{s:'Wireframing',p:40},{s:'Usability Testing',p:36},{s:'Interaction Design',p:34},{s:'Information Architecture',p:29},{s:'AX Design',p:22}],
};

function drawChart(container: HTMLElement, data: {s:string,p:number}[]) {
  const W = container.clientWidth || 560;
  const BAR_H = 32, GAP = 10, LABEL_W = 168, PCT_W = 40, PADDING = 12;
  const BAR_W = W - LABEL_W - PCT_W - PADDING;
  const H = data.length * (BAR_H + GAP);

  let svg = `<svg width="${W}" height="${H}" xmlns="http://www.w3.org/2000/svg" style="display:block; overflow:visible;">`;

  data.forEach((d, i) => {
    const y = i * (BAR_H + GAP);
    const barWidth = Math.max((d.p / 100) * BAR_W, 4);
    const fillColor = i === 0 ? '#1C3FBD' : i < 3 ? '#2D4FCA' : '#C5CFEE';
    const textColor = i < 3 ? '#1C3FBD' : '#9A969E';

    // Label
    svg += `<text x="${LABEL_W - 10}" y="${y + BAR_H / 2 + 4}" text-anchor="end" font-family="'JetBrains Mono',monospace" font-size="12" fill="#1A1A1A">${d.s}</text>`;
    // Track
    svg += `<rect x="${LABEL_W}" y="${y}" width="${BAR_W}" height="${BAR_H}" rx="4" fill="#EDEAE3"/>`;
    // Bar — use CSS animation via inline style
    svg += `<rect class="skill-bar" x="${LABEL_W}" y="${y}" width="${barWidth}" height="${BAR_H}" rx="4" fill="${fillColor}" style="transform-origin:${LABEL_W}px ${y + BAR_H/2}px; animation: growBar 0.6s cubic-bezier(.16,1,.3,1) ${i * 50}ms both;"><title>${d.s}: ${d.p}%</title></rect>`;
    // Percentage
    svg += `<text x="${LABEL_W + BAR_W + 8}" y="${y + BAR_H / 2 + 4}" font-family="'JetBrains Mono',monospace" font-size="11" fill="${textColor}">${d.p}%</text>`;
  });

  svg += `</svg>`;

  // Inject keyframe animation once
  if (!document.getElementById('skill-bar-keyframes')) {
    const style = document.createElement('style');
    style.id = 'skill-bar-keyframes';
    style.textContent = `@keyframes growBar { from { transform: scaleX(0); } to { transform: scaleX(1); } }`;
    document.head.appendChild(style);
  }

  container.innerHTML = svg;
}

document.querySelectorAll<HTMLElement>('.chart-root').forEach(root => {
  const chartId = root.dataset.chartId!;
  const hasToggle = root.dataset.toggle === 'true';
  const container = root.querySelector<HTMLElement>('.chart-container')!;
  const loading   = root.querySelector<HTMLElement>('.chart-loading')!;
  let current = 'weekly';
  let rendered = false;

  function render(period: string) {
    const data = SKILLS[period as keyof typeof SKILLS] || SKILLS.weekly;
    loading.style.display = 'none';
    drawChart(container, data);
  }

  // IntersectionObserver with fallback
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting && !rendered) {
          rendered = true;
          render(current);
          obs.disconnect();
        }
      });
    }, { threshold: 0.1 });
    obs.observe(root);
  } else {
    // Fallback: render immediately
    render(current);
  }

  // Period toggle
  if (hasToggle) {
    root.querySelectorAll<HTMLElement>('.period-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        current = btn.dataset.period!;
        root.querySelectorAll<HTMLElement>('.period-btn').forEach(b => {
          b.style.background = '#EDEAE3'; b.style.borderColor = '#E8E4DC'; b.style.color = '#6B6870';
        });
        btn.style.background = '#1C3FBD'; btn.style.borderColor = '#1532A8'; btn.style.color = '#fff';
        render(current);
      });
    });
  }
});
</script>
