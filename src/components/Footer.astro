---
---

<footer class="site-footer" id="subscribe">
  <div class="arcs" aria-hidden="true">
    <span class="arc"><span class="arc-orbit"><span class="arc-dot"></span></span></span>
    <span class="arc"><span class="arc-orbit"><span class="arc-dot"></span></span></span>
    <span class="arc"><span class="arc-orbit"><span class="arc-dot"></span></span></span>
    <span class="arc"><span class="arc-orbit"><span class="arc-dot"></span></span></span>
    <span class="arc"><span class="arc-orbit"><span class="arc-dot"></span></span></span>
    <span class="arc"><span class="arc-orbit"><span class="arc-dot"></span></span></span>
    <span class="arc"><span class="arc-orbit"><span class="arc-dot"></span></span></span>
    <span class="arc"><span class="arc-orbit"><span class="arc-dot"></span></span></span>
  </div>
  <div class="footer-content">
    <h2 class="subscribe-h2">Subscribe</h2>
    <p class="subscribe-sub">
      AX insights, top jobs, and in-demand skills —<br/>every week. No noise.
    </p>
    <form class="subscribe-form" id="footer-sub-form" novalidate>
      <input class="subscribe-input" type="email" name="email" placeholder="your@email.com" required />
      <button class="subscribe-btn" type="submit">Subscribe</button>
    </form>
    <p class="subscribe-msg" id="footer-sub-msg"></p>
    <div class="footer-logo-wrap">
      <img src="/logo-uxintoax.svg" alt="uxintoax" class="footer-logo-img" />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #050505;
    position: relative; overflow: hidden;
    min-height: 620px;
    display: flex; align-items: center; justify-content: center;
    padding: 0 24px; text-align: center;
  }

  /* ── arcs ── */
  .arcs { position: absolute; bottom: 0; left: 50%; pointer-events: none; }
  .arc {
    position: absolute; border-radius: 50%;
    border: 1px solid #1C1C1C;
    transform: translate(-50%, 50%); bottom: 0; left: 0;
  }
  .arc:nth-child(1) { width: 100px;  height: 100px;  }
  .arc:nth-child(2) { width: 230px;  height: 230px;  }
  .arc:nth-child(3) { width: 360px;  height: 360px;  }
  .arc:nth-child(4) { width: 490px;  height: 490px;  }
  .arc:nth-child(5) { width: 620px;  height: 620px;  }
  .arc:nth-child(6) { width: 750px;  height: 750px;  }
  .arc:nth-child(7) { width: 880px;  height: 880px;  }
  .arc:nth-child(8) { width: 1010px; height: 1010px; }

  .arc-orbit {
    position: absolute; inset: 0;
    animation: arcSpin var(--arc-dur, 10s) linear infinite;
  }
  .arc-dot {
    position: absolute;
    top: -4px; left: 50%;
    transform: translateX(-50%);
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #7CFF00;
    filter: blur(2.5px);
    box-shadow: 0 0 8px 2px rgba(124,255,0,0.9), 0 0 20px rgba(124,255,0,0.4);
  }
  @keyframes arcSpin {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  .arc:nth-child(1) .arc-orbit { --arc-dur: 7s;  animation-delay: -1s; }
  .arc:nth-child(2) .arc-orbit { --arc-dur: 9s;  animation-delay: -3s; }
  .arc:nth-child(3) .arc-orbit { --arc-dur: 11s; animation-delay: -2s; }
  .arc:nth-child(4) .arc-orbit { --arc-dur: 8s;  animation-delay: -5s; }
  .arc:nth-child(5) .arc-orbit { --arc-dur: 13s; animation-delay: -4s; }
  .arc:nth-child(6) .arc-orbit { --arc-dur: 10s; animation-delay: -1s; }
  .arc:nth-child(7) .arc-orbit { --arc-dur: 14s; animation-delay: -6s; }
  .arc:nth-child(8) .arc-orbit { --arc-dur: 16s; animation-delay: -3s; }

  /* ── content ── */
  .footer-content {
    position: relative; z-index: 1;
    display: flex; flex-direction: column; align-items: center;
    width: 100%; max-width: 560px;
    padding: 72px 0 60px;
  }
  .subscribe-h2 {
    font-family: 'Ultra', 'Bebas Neue', serif;
    font-size: 67px;
    color: #fff; line-height: 1;
    text-transform: uppercase; letter-spacing: 0.02em;
    margin-bottom: 10px;
  }
  .subscribe-sub {
    font-family: 'Open Sans', sans-serif;
    font-size: 1rem; color: rgba(255,255,255,0.5);
    line-height: 1.6; margin-bottom: 28px;
  }
  .subscribe-form {
    display: flex; gap: 0; width: 100%; max-width: 520px;
    border: 1px solid #2A2A2A; border-radius: 6px; overflow: hidden;
  }
  .subscribe-input {
    flex: 1; background: #111; border: none; outline: none;
    padding: 14px 18px; font-size: 0.9375rem;
    color: #E0E0E0; font-family: 'Open Sans', sans-serif;
    transition: background 0.15s; min-width: 0;
  }
  .subscribe-input::placeholder { color: #3A3A3A; }
  .subscribe-input:focus { background: #161616; }
  .subscribe-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem; font-weight: 700;
    background: #7CFF00; color: #000; border: none;
    padding: 14px 28px; cursor: pointer;
    transition: background 0.15s; white-space: nowrap; flex-shrink: 0;
  }
  .subscribe-btn:hover { background: #6AEC00; }
  .subscribe-msg {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem; color: #7CFF00;
    margin-top: 12px; display: none; align-self: flex-start;
  }
  .footer-logo-wrap { margin-top: 100px; }
  .footer-logo-img {
    height: clamp(3rem, 12vw, 7rem); width: auto;
    display: block; margin: 0 auto; user-select: none;
  }
</style>

<script>
  const form = document.getElementById('footer-sub-form') as HTMLFormElement | null;
  const msg  = document.getElementById('footer-sub-msg');
  form?.addEventListener('submit', e => {
    e.preventDefault();
    const email = (form.elements.namedItem('email') as HTMLInputElement)?.value?.trim();
    if (!email || !msg) return;
    msg.textContent = "✓ You're in. First digest coming soon.";
    msg.style.display = 'block';
    form.reset();
  });
</script>
