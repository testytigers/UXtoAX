---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description: string;
  category: string;
  author: string;
  publishedAt: string;
  updatedAt?: string;
  readTime: number;
  slug: string;
  tags?: string[];
  ogImage?: string;
  faqs?: Array<{ q: string; a: string }>;
}

const {
  title, description, category, author, publishedAt,
  updatedAt, readTime, slug, tags, ogImage, faqs,
} = Astro.props;

const canonical = `https://uxintoax.com/blog/${slug}`;
const dateFormatted = new Date(publishedAt).toLocaleDateString('en-GB', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<Base
  title={title}
  description={description}
  canonical={canonical}
  type="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  author={author}
  category={category}
  tags={tags}
  readTime={readTime}
  faqs={faqs}
  ogImage={ogImage ?? `https://uxintoax.com/og/blog/${slug}.png`}
  ogImageAlt={title}
>
  <style>
    html, body { background: #0B0B0B !important; color: #C8C8C8 !important; }
  </style>
  <Nav />
  <main class="post-main">
    <nav class="breadcrumb">
      <a href="/">Home</a>
      <span class="sep">›</span>
      <a href="/">Articles</a>
      <span class="sep">›</span>
      <span class="crumb-active">{category}</span>
    </nav>

    <header class="post-header">
      <span class="cat-badge">{category}</span>
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <span>{author}</span><span class="dot">·</span>
        <time datetime={publishedAt}>{dateFormatted}</time><span class="dot">·</span>
        <span>{readTime} min read</span>
        <a
          href={`https://linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}
          target="_blank" rel="noopener" class="share-link"
        >Share ↗</a>
      </div>
    </header>

    <article class="prose-dark"><slot /></article>

    {faqs && faqs.length > 0 && (
      <section class="faq-section">
        <h2 class="faq-heading">Frequently Asked Questions</h2>
        <div class="faq-list">
          {faqs.map(faq => (
            <div class="faq-item">
              <h3 class="faq-q">{faq.q}</h3>
              <p class="faq-a">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>
    )}
  </main>
  <Footer />
</Base>

<style>
  .post-main {
    max-width: 740px; margin: 0 auto;
    padding: 40px 24px 80px; flex: 1;
  }

  /* Breadcrumb */
  .breadcrumb {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem; margin-bottom: 32px;
    display: flex; align-items: center; gap: 4px;
    flex-wrap: wrap;
  }
  .breadcrumb a { color: #555; text-decoration: none; transition: color 0.12s; }
  .breadcrumb a:hover { color: #7CFF00; text-decoration: none; }
  .sep { color: #2A2A2A; margin: 0 4px; }
  .crumb-active { color: #888; }

  /* Header */
  .post-header { margin-bottom: 40px; }
  .cat-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem; font-weight: 700; color: #000;
    background: #7CFF00; padding: 3px 12px;
    border-radius: 3px; text-transform: uppercase;
    letter-spacing: 0.05em; display: inline-block;
    margin-bottom: 16px;
  }
  .post-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(1.625rem, 4vw, 2.25rem);
    font-weight: 700; color: #E8E8E8;
    line-height: 1.2; margin-bottom: 20px;
  }
  .post-meta {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem; color: #555;
    padding-top: 16px; border-top: 1px solid #1C1C1C;
  }
  .dot { color: #2A2A2A; }
  .share-link {
    margin-left: auto; color: #7CFF00;
    font-size: 0.75rem; text-decoration: none; transition: opacity 0.15s;
  }
  .share-link:hover { opacity: 0.75; text-decoration: none; }

  /* Prose */
  .prose-dark :global(h2) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.375rem; font-weight: 700; color: #E0E0E0;
    margin: 2.5rem 0 1rem; padding-bottom: 0.5rem;
    border-bottom: 1px solid #1C1C1C;
  }
  .prose-dark :global(h3) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.1rem; font-weight: 600; color: #D8D8D8;
    margin: 2rem 0 0.75rem;
  }
  .prose-dark :global(p) {
    color: #AAA; line-height: 1.8;
    margin-bottom: 1.25rem; font-size: 1rem;
  }
  .prose-dark :global(ul), .prose-dark :global(ol) {
    padding-left: 1.5rem; margin-bottom: 1.25rem;
    color: #AAA; line-height: 1.8;
  }
  .prose-dark :global(li) { margin-bottom: 0.5rem; }
  .prose-dark :global(strong) { color: #E0E0E0; font-weight: 600; }
  .prose-dark :global(a) { color: #7CFF00; text-decoration: none; }
  .prose-dark :global(a:hover) { text-decoration: underline; }
  .prose-dark :global(code) {
    font-family: 'JetBrains Mono', monospace;
    background: #181818; border: 1px solid #2A2A2A;
    padding: 0.2em 0.45em; border-radius: 4px;
    font-size: 0.875em; color: #7CFF00;
  }
  .prose-dark :global(pre) {
    background: #141414; border: 1px solid #2A2A2A;
    border-radius: 6px; padding: 1.25rem;
    overflow-x: auto; margin: 1.5rem 0;
  }
  .prose-dark :global(pre code) {
    background: none; border: none; padding: 0;
    font-size: 0.875rem; color: #C8C8C8;
  }
  .prose-dark :global(blockquote) {
    border-left: 3px solid #7CFF00;
    padding-left: 1.25rem; margin: 1.5rem 0;
    color: #666; font-style: italic;
  }
  .prose-dark :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; }
  .prose-dark :global(th) {
    background: #181818; font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem; padding: 10px 14px; text-align: left;
    border: 1px solid #2A2A2A; color: #AAA;
  }
  .prose-dark :global(td) { padding: 10px 14px; border: 1px solid #1C1C1C; font-size: 0.9rem; color: #888; }
  .prose-dark :global(tr:nth-child(even) td) { background: #141414; }
  .prose-dark :global(hr) { border: none; border-top: 1px solid #1C1C1C; margin: 2rem 0; }
  .prose-dark :global(img) { border-radius: 6px; border: 1px solid #2A2A2A; max-width: 100%; }

  /* FAQ */
  .faq-section { margin-top: 56px; padding-top: 40px; border-top: 1px solid #1C1C1C; }
  .faq-heading {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.25rem; font-weight: 700; color: #E0E0E0; margin-bottom: 20px;
  }
  .faq-list { display: flex; flex-direction: column; gap: 10px; }
  .faq-item {
    background: #141414; border: 1px solid #2A2A2A;
    border-radius: 6px; padding: 20px;
  }
  .faq-q {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem; font-weight: 600; color: #DDD; margin-bottom: 8px;
  }
  .faq-a { font-size: 0.875rem; color: #777; line-height: 1.7; }
</style>
