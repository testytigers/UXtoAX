---
import SEO from '../components/SEO.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'job' | 'dataset';
  publishedAt?: string;
  updatedAt?: string;
  author?: string;
  category?: string;
  tags?: string[];
  readTime?: number;
  ogImage?: string;
  ogImageAlt?: string;
  schema?: object;
  faqs?: Array<{ q: string; a: string }>;
}

const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO {...props} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=JetBrains+Mono:wght@400;500;600;700&family=Open+Sans:wght@400;500;600&family=Ultra&family=UnifrakturMaguntia&display=swap" rel="stylesheet" />

    <style>
      :root {
        --bg:     #FAFAF8;
        --white:  #FFFFFF;
        --surface:#F4F2EE;
        --raised: #EDEAE3;
        --border: #E8E4DC;
        --accent:      #1C3FBD;
        --accent-deep: #1532A8;
        --accent2:     #2D4FCA;
        --al:          #EEF1FB;
        --alb:         #C5CFEE;
        --text:        #1A1A1A;
        --muted:       #6B6870;
        --subtle:      #9A969E;
      }

      *, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }

      html {
        background: var(--bg);
        color: var(--text);
        font-family: 'Open Sans', sans-serif;
        font-size: 16px;
        line-height: 1.6;
        -webkit-text-size-adjust: 100%;
        -webkit-font-smoothing: antialiased;
      }

      /* ─── Type ─── */
      h1,h2,h3,h4,h5,h6 {
        font-family:'JetBrains Mono',monospace;
        line-height:1.2; color:var(--text); letter-spacing:-0.02em;
      }
      p  { font-size:1rem; line-height:1.7; }
      a  { color:var(--accent); text-decoration:none; }
      a:hover { text-decoration:underline; }

      /* ─── Layout helpers ─── */
      .container { max-width:1200px; margin:0 auto; padding:0 24px; }

      /* ─── Pills ─── */
      .pill { display:inline-flex; align-items:center; gap:5px; font-family:'JetBrains Mono',monospace; font-size:0.7rem; font-weight:600; padding:3px 11px; border-radius:20px; white-space:nowrap; }
      .pill-accent  { color:var(--accent);  background:var(--al);     border:1px solid var(--alb);    }
      .pill-neutral { color:var(--muted);   background:var(--raised); border:1px solid var(--border); }
      .pill-green   { color:#15803D; background:#ECFDF3; border:1px solid #BBF7D0; }
      .pill-amber   { color:#92400E; background:#FFFBEB; border:1px solid #FDE68A; }

      /* ─── Buttons ─── */
      .btn { display:inline-flex; align-items:center; gap:7px; font-family:'JetBrains Mono',monospace; font-weight:600; border-radius:8px; text-decoration:none; transition:background 0.15s, border-color 0.15s; cursor:pointer; }
      .btn-primary { background:var(--accent); color:#fff; border:1px solid var(--accent-deep); }
      .btn-primary:hover { background:var(--accent-deep); text-decoration:none; }
      .btn-ghost   { background:transparent; color:var(--text); border:1px solid var(--border); }
      .btn-ghost:hover { background:var(--surface); border-color:#C8C4BC; text-decoration:none; }

      /* ─── Cards ─── */
      .card { background:#FFFFFF; border:1px solid var(--border); border-radius:10px; transition:border-color 0.15s; }
      .card:hover { border-color:var(--alb); }

      /* ─── Eyebrow label ─── */
      .eyebrow { font-family:'JetBrains Mono',monospace; font-size:0.72rem; font-weight:600; color:var(--subtle); text-transform:uppercase; letter-spacing:0.08em; }

      /* ─── Divider grid (1px separators) ─── */
      .divider-grid { display:grid; gap:1px; background:var(--border); border:1px solid var(--border); border-radius:10px; overflow:hidden; }
      .divider-grid > * { background:#FFFFFF; }

      /* ─── Animations ─── */
      @keyframes ticker  { from{transform:translateX(0)} to{transform:translateX(-50%)} }
      @keyframes fadeUp  { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
      .fu  { opacity:0; animation:fadeUp 0.7s cubic-bezier(.16,1,.3,1) forwards; }
      .fu1 { animation-delay:.06s; } .fu2 { animation-delay:.16s; }
      .fu3 { animation-delay:.28s; } .fu4 { animation-delay:.42s; }

      /* ─── Scrollbar ─── */
      ::-webkit-scrollbar { width:5px; }
      ::-webkit-scrollbar-track { background:var(--bg); }
      ::-webkit-scrollbar-thumb { background:var(--border); border-radius:3px; }
    </style>
  </head>
  <body style="background:var(--bg); min-height:100vh; display:flex; flex-direction:column;">
    <slot />
  </body>
</html>
